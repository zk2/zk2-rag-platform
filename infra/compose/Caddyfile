# Reverse proxy for the single-host production stack.
#
# One origin serves everything: the browser app at /, the API under /api, and
# the chat WebSocket through the same /api prefix. Sharing an origin is what
# lets the app's CSP stay at `connect-src 'self'` and keeps the API off the
# public network on its own port.
#
# TLS is terminated by the host's proxy in front of this container, so Caddy
# speaks plain HTTP here and never asks for a certificate.

{
	admin off
	auto_https off
	servers {
		# Trust the address the proxy in front reports, so the API's per-IP
		# rate limits see the client rather than the proxy.
		trusted_proxies static private_ranges
	}
}

# Langfuse, when it is published under a name of its own. Caddy matches the
# Host header, so the proxy in front can send both names to this same port and
# the site blocks sort them out. Unset, the placeholder matches nothing and
# Langfuse stays reachable only over an SSH tunnel.
{$LANGFUSE_HOSTNAME:langfuse.invalid}:80 {
	encode gzip

	log {
		output stdout
		format console
	}

	reverse_proxy langfuse-web:3000

	# Switched off in Admin -> Services, the container is gone and its name no
	# longer resolves. A bare 502 would read as an outage; this says what it is.
	handle_errors 502 503 {
		respond "Langfuse is switched off. A super-admin can switch it on in the admin panel, under Services." 503
	}
}

:80 {
	encode gzip

	log {
		output stdout
		format console
	}

	# /metrics is a Prometheus scrape target, and Prometheus reaches the API
	# directly inside this network. Nothing outside has any business there.
	handle /api/metrics {
		respond "Not found" 404
	}

	# The host agent reports here, over the compose network. It is token-checked,
	# but nobody outside is ever the agent, so from outside it does not exist.
	handle /api/ops/agent/* {
		respond "Not found" 404
	}

	# The API is mounted under /api and told so via root_path, so the links it
	# generates (docs, openapi.json) keep the prefix the browser used.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
