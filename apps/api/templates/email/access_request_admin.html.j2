{% extends "_base.html.j2" %}
{% set subject = "[zk2] New access request" %}
{% block body %}
  <h2 style="font-size: 20px; color: #0f172a; margin: 0 0 16px;">New access request</h2>
  <p style="color: #334155; line-height: 1.6;">
    <strong>{{ email }}</strong> has requested access.
  </p>
  {% if message %}
    <blockquote style="border-left: 3px solid #cbd5e1; padding: 8px 16px; color: #475569; background: #f8fafc; border-radius: 4px;">
      {{ message }}
    </blockquote>
  {% endif %}
  <p style="text-align: center; margin: 32px 0;">
    <a href="{{ admin_url }}" style="background: #0f172a; color: #fff; padding: 12px 24px; border-radius: 8px; text-decoration: none; display: inline-block; font-weight: 600;">Review in admin</a>
  </p>
{% endblock %}
