# ─── App ─────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=zk2-chatbot
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zk2
DB_USER=zk2
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
INVITE_TTL_SECONDS=604800
ALLOWED_EMAIL_DOMAINS=*

# ─── OAuth ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Email (Mailgun SMTP) ────────────────────────────────────
SMTP_SERVER=smtp.mailgun.org
SMTP_PORT=465
SMTP_USE_SSL=true
EMAIL_SENDER=zk2@mailgun.zeka.kiev.ua
EMAIL_PASSWORD=
# For local dev override:
# SMTP_SERVER=localhost
# SMTP_PORT=1025
# SMTP_USE_SSL=false
# EMAIL_PASSWORD=

# ─── LLM (org-level keys can override) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Embeddings cache ────────────────────────────────────────
HF_HUB_CACHE=./.cache/hf

# ─── Search tools ────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# ─── Billing ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Observability ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=zk2-api
SENTRY_DSN=

# ─── Ingest limits / SSRF ────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
MAX_FETCH_BYTES=10485760
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
SITEMAP_DEFAULT_LIMIT=100
SITEMAP_MAX_LIMIT=500
# Never true in staging/prod - allows fetching private addresses
SSRF_ALLOW_PRIVATE_NETWORKS=false
EMBEDDING_BATCH_SIZE=100

# ─── Chat / WebSocket ────────────────────────────────────────
MAX_WS_MESSAGE_BYTES=32768
WS_IDLE_TIMEOUT_SECONDS=900

# ─── Storage ─────────────────────────────────────────────────
STORAGE_KIND=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Super-admin seed ────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_EMAIL=1
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_IP=5
