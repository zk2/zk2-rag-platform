# ─── App ─────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=zk2-rag-platform
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zk2
DB_USER=zk2
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
INVITE_TTL_SECONDS=604800
ALLOWED_EMAIL_DOMAINS=*

# ─── OAuth ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Email (Mailgun SMTP) ────────────────────────────────────
SMTP_SERVER=smtp.mailgun.org
SMTP_PORT=465
SMTP_USE_SSL=true
# Empty means "authenticate as EMAIL_SENDER", which is what Mailgun and MailHog
# expect. Resend instead wants the literal user "resend", API key as password.
SMTP_USERNAME=
EMAIL_SENDER=zk2@mailgun.zeka.kiev.ua
EMAIL_PASSWORD=
# For local dev override:
# SMTP_SERVER=localhost
# SMTP_PORT=1025
# SMTP_USE_SSL=false
# EMAIL_PASSWORD=

# ─── LLM (org-level keys can override) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Embeddings cache ────────────────────────────────────────
HF_HUB_CACHE=./.cache/hf

# ─── Search tools ────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# ─── Billing ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Observability ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
# Where a person opens Langfuse. Only differs from LANGFUSE_HOST when the app
# reaches it by a service name; that is the compose case, not this one.
LANGFUSE_PUBLIC_URL=http://localhost:3030
# Only used by the langfuse container in docker-compose
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=zk2-api
SENTRY_DSN=
METRICS_ENABLED=true
METRICS_TOKEN=          # set when /metrics is reachable from outside the cluster
GRAFANA_URL=http://localhost:3001
JAEGER_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090

# ─── Ingest limits / SSRF ────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
MAX_FETCH_BYTES=10485760
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
SITEMAP_DEFAULT_LIMIT=100
SITEMAP_MAX_LIMIT=500
# Never true in staging/prod - allows fetching private addresses
SSRF_ALLOW_PRIVATE_NETWORKS=false
EMBEDDING_BATCH_SIZE=100
# All models are normalised to this width; pgvector caps HNSW at 2000
EMBEDDING_DIMENSIONS=1536

# ─── Shared-key allowance (not billing) ──────────────────────
# How many tokens an organization may take from the deployment's own provider
# keys before it has to add its own. 0 window days = for the lifetime of the org.
SYSTEM_KEYS_ENABLED=true
SYSTEM_KEY_TOKEN_LIMIT=200000
SYSTEM_KEY_WINDOW_DAYS=0

# ─── Retrieval ───────────────────────────────────────────────
# Cross-encoder reranking. The image ships the extra and the model; locally it
# needs `cd apps/api && uv sync --extra rerank`, and without it the chat keeps
# the fused order instead of failing.
#
# A cross-encoder costs one forward pass per candidate, on the turn the user is
# waiting for. Measured on twelve CPU cores over thirty candidates: the default
# 3.5s, BAAI/bge-reranker-base 18s, BAAI/bge-reranker-v2-m3 30s. The last two
# are the better models and belong on a GPU.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=15
RERANK_MAX_TOKENS=512

# ─── Chat / WebSocket ────────────────────────────────────────
MAX_WS_MESSAGE_BYTES=32768
WS_IDLE_TIMEOUT_SECONDS=900

# ─── Storage ─────────────────────────────────────────────────
STORAGE_KIND=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Super-admin seed ────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15
# Only behind a proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_EMAIL=1
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_IP=5
