# Production environment for the compose stack on a single host.
#
#   cp .env.prod.example .env.prod   and fill in every line marked REQUIRED.
#
# This file is read by `docker compose --env-file .env.prod`, both for the
# values compose itself interpolates (passwords, bind addresses) and, through
# `env_file:`, for the application containers. Host names here are compose
# service names: the API talks to "postgres", not to localhost.

# ─── App ─────────────────────────────────────────────────────
APP_ENV=prod
APP_NAME=zk2-rag-platform
# REQUIRED. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every encrypted provider key - see
# docs/runbooks/key-rotation.md before you change it on a live deployment.
APP_SECRET_KEY=
# REQUIRED. The public URL the browser uses. It is the CORS allowlist and the
# base for magic links and invites, so a wrong value means unopenable emails.
APP_BASE_URL=https://demo.example.com
API_BASE_URL=https://demo.example.com/api
LOG_LEVEL=INFO

# ─── Reverse proxy ───────────────────────────────────────────
# Caddy is the only published port. Narrow HTTP_BIND to the address of the
# proxy in front when that proxy is not on this host.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# Observability UIs bind here. Keep it on loopback and reach them through an
# SSH tunnel: ssh -L 3001:127.0.0.1:3001 <server>
OBS_BIND=127.0.0.1

# ─── Database ────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zk2
DB_USER=zk2
# REQUIRED. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
INVITE_TTL_SECONDS=604800
ALLOWED_EMAIL_DOMAINS=*

# ─── Email (Resend SMTP) ─────────────────────────────────────
SMTP_SERVER=smtp.resend.com
SMTP_PORT=465
SMTP_USE_SSL=true
# Resend authenticates as the literal user "resend" with the API key as the
# password, whatever the sender address is.
SMTP_USERNAME=resend
EMAIL_SENDER=zk2@reldava.com
# REQUIRED for invites and magic links to leave the box. Resend API key.
EMAIL_PASSWORD=

# ─── LLM (organizations may bring their own keys) ────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Search tools ────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=

# ─── Observability ───────────────────────────────────────────
# The keys the application traces with. Langfuse creates exactly these on its
# first start (LANGFUSE_INIT_* in the compose file), so invent them here rather
# than clicking through the UI afterwards:
#   echo "pk-lf-$(openssl rand -hex 16)" ; echo "sk-lf-$(openssl rand -hex 16)"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Service addresses inside the compose network. Empty both when running
# without the `obs` profile, or the api retries every export forever.
LANGFUSE_HOST=http://langfuse-web:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# REQUIRED when the obs profile runs. Generate like APP_SECRET_KEY, except
# ENCRYPTION_KEY, which must be exactly 64 hex characters: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
# The account Langfuse creates for itself on first start. Its own login, with
# nothing to do with the application's users.
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_PASSWORD=
# Where Langfuse thinks it lives; over a tunnel this stays localhost. It has to
# match the address in the browser or the sign-in will not stick.
LANGFUSE_PUBLIC_URL=http://localhost:3030
LANGFUSE_MINIO_PUBLIC_URL=http://localhost:9092
# REQUIRED when the obs profile runs.
GRAFANA_ADMIN_PASSWORD=
OTEL_SERVICE_NAME=zk2-api
SENTRY_DSN=
METRICS_ENABLED=true
# Prometheus scrapes api:8000 inside the compose network and the proxy answers
# 404 for /api/metrics, so a token is belt and braces. Set one if you ever
# publish the port.
METRICS_TOKEN=
# Shown in the admin UI as links; these are tunnel addresses, not public ones.
GRAFANA_URL=http://localhost:3001
JAEGER_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090

# ─── Ingest limits / SSRF ────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
MAX_FETCH_BYTES=10485760
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
SITEMAP_DEFAULT_LIMIT=100
SITEMAP_MAX_LIMIT=500
# Never true here: it would let a user's "source URL" reach the database.
SSRF_ALLOW_PRIVATE_NETWORKS=false
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536

# ─── Shared-key allowance ────────────────────────────────────
SYSTEM_KEYS_ENABLED=true
SYSTEM_KEY_TOKEN_LIMIT=200000
SYSTEM_KEY_WINDOW_DAYS=0

# ─── Retrieval ───────────────────────────────────────────────
# The reranker pulls torch into the image; leave it off unless the image was
# built with the `rerank` extra.
RERANK_ENABLED=false

# ─── Chat / WebSocket ────────────────────────────────────────
MAX_WS_MESSAGE_BYTES=32768
WS_IDLE_TIMEOUT_SECONDS=900

# ─── Storage ─────────────────────────────────────────────────
STORAGE_KIND=local
LOCAL_UPLOAD_DIR=/app/uploads

# ─── Super-admin seed ────────────────────────────────────────
# REQUIRED once, for `make prod-seed`. Self-signup does not exist: without this
# there is no way into the deployment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15
# Caddy sets X-Forwarded-For, and compose sets this for the app containers too.
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_EMAIL=1
RATE_LIMIT_ACCESS_REQUEST_PER_HOUR_PER_IP=5
